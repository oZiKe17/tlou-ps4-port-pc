set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

if(NOT MINGW_BIN)
    set(MINGW_BIN "$ENV{MINGW_BIN}")
endif()
if(NOT MINGW_BIN)
    message(FATAL_ERROR "Set MINGW_BIN to the directory containing x86_64-w64-mingw32-gcc/g++.")
endif()

set(CMAKE_C_COMPILER "${MINGW_BIN}/x86_64-w64-mingw32-gcc")
set(CMAKE_CXX_COMPILER "${MINGW_BIN}/x86_64-w64-mingw32-g++")
set(CMAKE_RC_COMPILER "${MINGW_BIN}/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${MINGW_BIN}/../x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
